# ---- v1 backend (existing, required) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---- v2 (all optional) ----
# Point v2 at its own backend. Leave empty to share the v1 backend.
VITE_V2_SUPABASE_URL=
VITE_V2_SUPABASE_PUBLISHABLE_KEY=
# Storage bucket for evidence files
VITE_V2_EVIDENCE_BUCKET=evidence
# Edge function that analyses one frame
VITE_V2_DETECT_FUNCTION=process-evidence
# Frames sampled from each video, and parallel AI calls
VITE_V2_FRAMES_PER_VIDEO=5
VITE_V2_AI_CONCURRENCY=3
# Share of sightings that must agree before a violation is "confirmed" (0-1)
VITE_V2_CONFIRM_THRESHOLD=0.6
